<mvc:View
    controllerName="com.app.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:card="sap.f.cards"
    height="100%">
    <ScrollContainer horizontal="false" vertical="true" height="100%" width="100%">

        <!-- Hero -->
        <VBox class="hero-section" renderType="Bare">
            <Image src="./assets/bglp.png" width="100%" alt="" decorative="true" class="card-background-image"/>
            <VBox class="full-overlay-content" renderType="Bare">
                <VBox class="card-overlay-text" renderType="Bare">
                    <Title text="{i18n>heroTitle}" level="H1" class="sub-title"/>
                    <Title text="{i18n>heroSubtitle}" level="H2" wrapping="true" class="main-title"/>
                    <Text text="{i18n>heroText}" class="description-text"/>
                </VBox>
                <SearchField
                    placeholder="{i18n>heroSearchPlaceholder}"
                    search=".onSearch"
                    class="card-overlay-search"/>
                <HBox wrap="Wrap" class="hero-actions">
                    <Button text="{i18n>heroExplore}" icon="sap-icon://search" type="Emphasized" press=".onExplore" class="sapUiSmallMarginEnd sapUiSmallMarginTop"/>
                    <Button text="{i18n>heroCreate}" icon="sap-icon://add" press=".onManage" class="hero-secondary-button sapUiSmallMarginTop"/>
                </HBox>
            </VBox>
        </VBox>

        <!-- Services -->
        <VBox alignItems="Center" class="services-section">
            <Title text="{i18n>servicesTitle}" level="H2" class="services-title"/>
            <FlexBox wrap="Wrap" justifyContent="Center" class="services-cards-container">
                <f:Card class="service-card">
                    <f:header>
                        <card:Header
                            title="{i18n>cardExploreTitle}"
                            subtitle="{i18n>cardExploreSubtitle}"
                            iconSrc="sap-icon://search"
                            press=".onExplore"/>
                    </f:header>
                    <f:content>
                        <VBox class="service-card-content">
                            <Text text="{i18n>cardExploreText}" class="service-card-text"/>
                            <Link text="{i18n>cardExploreLink}" press=".onExplore" class="sapUiSmallMarginTop"/>
                        </VBox>
                    </f:content>
                </f:Card>

                <f:Card class="service-card">
                    <f:header>
                        <card:Header
                            title="{i18n>cardManageTitle}"
                            subtitle="{i18n>cardManageSubtitle}"
                            iconSrc="sap-icon://settings"
                            press=".onManage"/>
                    </f:header>
                    <f:content>
                        <VBox class="service-card-content">
                            <Text text="{i18n>cardManageText}" class="service-card-text"/>
                            <Link text="{i18n>cardManageLink}" press=".onManage" class="sapUiSmallMarginTop"/>
                        </VBox>
                    </f:content>
                </f:Card>

                <f:Card class="service-card">
                    <f:header>
                        <card:Header
                            title="{i18n>cardAskTitle}"
                            subtitle="{i18n>cardAskSubtitle}"
                            iconSrc="sap-icon://message-information"
                            press=".onAskApi"/>
                    </f:header>
                    <f:content>
                        <VBox class="service-card-content">
                            <Text text="{i18n>cardAskText}" class="service-card-text"/>
                            <Link text="{i18n>cardAskLink}" press=".onAskApi" class="sapUiSmallMarginTop"/>
                        </VBox>
                    </f:content>
                </f:Card>
            </FlexBox>
        </VBox>

        <!-- Footer -->
        <Toolbar class="appFooter">
            <ToolbarSpacer/>
            <Text text="{i18n>footerText}"/>
            <ToolbarSpacer/>
        </Toolbar>
    </ScrollContainer>
</mvc:View>

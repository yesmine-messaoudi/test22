<mvc:View
    controllerName="com.app.controller.ManageUsers"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:sap.m="sap.m"
    xmlns:sap.ui.layout="sap.ui.layout"
    xmlns:sap.ui.table="sap.ui.table"
    displayBlock="true">

    <sap.m:Page title="Manage Users">
        <sap.m:content>
            <sap.ui.layout:VerticalLayout width="100%" >
                <sap.m:Button text="Create User" press=".onCreateUser" class="sapUiSmallMargin"/>
                <sap.ui.table:Table
                    id="usersTable"
                    rows="{/users}"
                    selectionMode="Single"
                    visibleRowCount="10"
                    ariaLabelledBy="title">
                    <sap.ui.table:columns>
                        <sap.ui.table:Column width="11rem">
                            <sap.m:Label text="Email"/>
                            <sap.ui.table:template>
                                <sap.m:Text text="{email}" wrapping="false"/>
                            </sap.ui.table:template>
                        </sap.ui.table:Column>
                        <sap.ui.table:Column width="11rem">
                            <sap.m:Label text="First Name"/>
                            <sap.ui.table:template>
                                <sap.m:Text text="{firstName}" wrapping="false"/>
                            </sap.ui.table:template>
                        </sap.ui.table:Column>
                        <sap.ui.table:Column width="11rem">
                            <sap.m:Label text="Last Name"/>
                            <sap.ui.table:template>
                                <sap.m:Text text="{lastName}" wrapping="false"/>
                            </sap.ui.table:template>
                        </sap.ui.table:Column>
                         <sap.ui.table:Column width="6rem">
                            <sap.m:Label text="Role"/>
                            <sap.ui.table:template>
                                <sap.m:Text text="{role}" wrapping="false"/>
                            </sap.ui.table:template>
                        </sap.ui.table:Column>
                        <sap.ui.table:Column width="10rem">
                            <sap.m:Label text="Actions"/>
                            <sap.ui.table:template>
                                <sap.m:HBox>
                                    <sap.m:Button icon="sap-icon://show-details" type="Transparent" press=".onConsultUser" tooltip="Consult"/>
                                    <sap.m:Button icon="sap-icon://edit" type="Transparent" press=".onUpdateUser" tooltip="Update"/>
                                    <sap.m:Button icon="sap-icon://delete" type="Transparent" press=".onDeleteUser" tooltip="Delete"/>
                                </sap.m:HBox>
                            </sap.ui.table:template>
                        </sap.ui.table:Column>
                    </sap.ui.table:columns>
                </sap.ui.table:Table>
            </sap.ui.layout:VerticalLayout>
        </sap.m:content>
    </sap.m:Page>

</mvc:View> 
<mvc:View
    controllerName="com.app.controller.ApiDetail"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:uxap="sap.uxap"
    height="100%">
    <uxap:ObjectPageLayout
        id="objectPage"
        showTitleInHeaderContent="true"
        upperCaseAnchorBar="false"
        busy="{view>/busy}"
        busyIndicatorDelay="0"
        class="apiHubPage">
        <uxap:headerTitle>
            <uxap:ObjectPageDynamicHeaderTitle>
                <uxap:breadcrumbs>
                    <Breadcrumbs>
                        <Link text="{view>/listTitle}" press=".onNavToList"/>
                    </Breadcrumbs>
                </uxap:breadcrumbs>
                <uxap:expandedHeading>
                    <Title text="{api>/title}" level="H2" wrapping="true"/>
                </uxap:expandedHeading>
                <uxap:snappedHeading>
                    <FlexBox alignItems="Center">
                        <Title text="{api>/title}" level="H2" class="sapUiTinyMarginEnd"/>
                        <ObjectStatus
                            text="{path: 'api>/type', formatter: '.formatter.typeText'}"
                            state="Information"
                            inverted="true"
                            visible="{= !${view>/isInternal} }"/>
                    </FlexBox>
                </uxap:snappedHeading>
                <uxap:expandedContent>
                    <Text text="{api>/description}"/>
                </uxap:expandedContent>
                <uxap:actions>
                    <Button
                        text="{i18n>openDocument}"
                        icon="sap-icon://action"
                        type="Emphasized"
                        press=".onOpenDocument"
                        visible="{= ${view>/isInternal} &amp;&amp; !!${api>/url} }"/>
                </uxap:actions>
                <uxap:navigationActions>
                    <Button icon="sap-icon://decline" type="Transparent" tooltip="{i18n>close}" press=".onNavToList"/>
                </uxap:navigationActions>
            </uxap:ObjectPageDynamicHeaderTitle>
        </uxap:headerTitle>

        <uxap:headerContent>
            <!-- SAP standard API -->
            <FlexBox wrap="Wrap" visible="{= !${view>/isInternal} }">
                <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
                    <Label text="{i18n>fieldType}"/>
                    <ObjectStatus text="{path: 'api>/type', formatter: '.formatter.typeText'}" state="Information" inverted="true"/>
                </VBox>
                <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
                    <Label text="{i18n>fieldVersion}"/>
                    <Text text="{api>/version}"/>
                </VBox>
                <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
                    <Label text="{i18n>fieldStatus}"/>
                    <ObjectStatus text="{api>/status}" state="{path: 'api>/status', formatter: '.formatter.statusState'}"/>
                </VBox>
                <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
                    <Label text="{i18n>fieldLastModified}"/>
                    <Text text="{path: 'api>/lastModified', formatter: '.formatter.date'}"/>
                </VBox>
            </FlexBox>

            <!-- Internal API (SharePoint document) -->
            <FlexBox wrap="Wrap" visible="{view>/isInternal}">
                <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
                    <Label text="{i18n>fieldFileName}"/>
                    <Text text="{api>/fileName}"/>
                </VBox>
                <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
                    <Label text="{i18n>fieldAuthor}"/>
                    <Text text="{= ${api>/author} || '-' }"/>
                </VBox>
                <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
                    <Label text="{i18n>fieldCreated}"/>
                    <Text text="{api>/createdDate}"/>
                </VBox>
                <VBox class="sapUiMediumMarginEnd sapUiSmallMarginBottom">
                    <Label text="{i18n>fieldLastModified}"/>
                    <Text text="{path: 'api>/lastModified', formatter: '.formatter.date'}"/>
                </VBox>
            </FlexBox>
        </uxap:headerContent>

        <uxap:sections>
            <!-- SAP standard REST API: methods -->
            <uxap:ObjectPageSection
                title="{i18n>sectionMethods}"
                titleUppercase="false"
                visible="{= !${view>/isInternal} &amp;&amp; !${view>/isSoap} }">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection showTitle="false">
                        <uxap:blocks>
                            <Table
                                id="methodsTable"
                                items="{api>/methods}"
                                noDataText="{i18n>noMethods}"
                                growing="true"
                                growingThreshold="50">
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="{i18n>sectionMethods}" level="H3"/>
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column width="7rem">
                                        <Text text="{i18n>fieldMethod}"/>
                                    </Column>
                                    <Column>
                                        <Text text="{i18n>fieldPath}"/>
                                    </Column>
                                    <Column minScreenWidth="Tablet" demandPopin="true">
                                        <Text text="{i18n>fieldDescription}"/>
                                    </Column>
                                    <Column minScreenWidth="Desktop" demandPopin="true">
                                        <Text text="{i18n>fieldSection}"/>
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <ObjectStatus text="{api>method}" state="{path: 'api>method', formatter: '.formatter.methodState'}" inverted="true"/>
                                            <Text text="{api>path}" class="apiPath"/>
                                            <Text text="{api>description}"/>
                                            <Text text="{api>section}"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- SAP standard SOAP API: operations -->
            <uxap:ObjectPageSection
                title="{i18n>sectionOperations}"
                titleUppercase="false"
                visible="{= !${view>/isInternal} &amp;&amp; !!${view>/isSoap} }">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection showTitle="false">
                        <uxap:blocks>
                            <Table
                                id="operationsTable"
                                items="{api>/operations}"
                                noDataText="{i18n>noOperations}"
                                growing="true"
                                growingThreshold="50">
                                <headerToolbar>
                                    <OverflowToolbar>
                                        <Title text="{i18n>sectionOperations}" level="H3"/>
                                    </OverflowToolbar>
                                </headerToolbar>
                                <columns>
                                    <Column>
                                        <Text text="{i18n>fieldPortType}"/>
                                    </Column>
                                    <Column minScreenWidth="Tablet" demandPopin="true">
                                        <Text text="{i18n>fieldPort}"/>
                                    </Column>
                                    <Column minScreenWidth="Tablet" demandPopin="true">
                                        <Text text="{i18n>fieldProtocol}"/>
                                    </Column>
                                    <Column minScreenWidth="Desktop" demandPopin="true">
                                        <Text text="{i18n>fieldTransportProtocol}"/>
                                    </Column>
                                    <Column minScreenWidth="Desktop" demandPopin="true">
                                        <Text text="{i18n>fieldDefaultStyle}"/>
                                    </Column>
                                    <Column minScreenWidth="Desktop" demandPopin="true">
                                        <Text text="{i18n>fieldLocation}"/>
                                    </Column>
                                </columns>
                                <items>
                                    <ColumnListItem>
                                        <cells>
                                            <ObjectIdentifier title="{api>portType}" text="{api>namespace}"/>
                                            <Text text="{api>port}"/>
                                            <Text text="{api>protocol}"/>
                                            <Text text="{api>transportProtocol}"/>
                                            <Text text="{api>defaultStyle}"/>
                                            <Text text="{api>location}" class="apiPath"/>
                                        </cells>
                                    </ColumnListItem>
                                </items>
                            </Table>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>

            <!-- Internal API (SharePoint document): summary and keywords -->
            <uxap:ObjectPageSection title="{i18n>sectionSummary}" titleUppercase="false" visible="{view>/isInternal}">
                <uxap:subSections>
                    <uxap:ObjectPageSubSection showTitle="false">
                        <uxap:blocks>
                            <VBox>
                                <Text text="{= ${api>/description} || ${i18n>noSummary} }" class="sapUiSmallMarginBottom"/>
                                <Label text="{i18n>fieldKeywords}" class="sapUiSmallMarginTop"/>
                                <Text text="{= ${api>/keywords} || '-' }"/>
                                <Label text="{i18n>fieldUrl}" class="sapUiSmallMarginTop"/>
                                <Link text="{api>/url}" href="{api>/url}" target="_blank" wrapping="true"/>
                            </VBox>
                        </uxap:blocks>
                    </uxap:ObjectPageSubSection>
                </uxap:subSections>
            </uxap:ObjectPageSection>
        </uxap:sections>
    </uxap:ObjectPageLayout>
</mvc:View>

<mvc:View
    controllerName="com.app.controller.ApiList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    height="100%">
    <f:DynamicPage id="apiListPage" toggleHeaderOnTitleClick="false" class="apiHubPage">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{view>/title}" level="H2"/>
                </f:heading>
                <f:expandedContent>
                    <Text text="{view>/subtitle}"/>
                </f:expandedContent>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="false">
                <FlexBox wrap="Wrap" alignItems="Center">
                    <SearchField
                        id="searchField"
                        width="22rem"
                        placeholder="{i18n>searchPlaceholder}"
                        search=".onSearch"
                        liveChange=".onSearchLiveChange"
                        class="sapUiSmallMarginEnd sapUiTinyMarginBottom"/>
                    <SegmentedButton id="typeFilter" selectedKey="all" selectionChange=".onTypeChange" visible="{= !${view>/isInternal} }" class="sapUiTinyMarginBottom">
                        <items>
                            <SegmentedButtonItem key="all" text="{i18n>typeAll}"/>
                            <SegmentedButtonItem key="rest" text="REST"/>
                            <SegmentedButtonItem key="soap" text="SOAP"/>
                        </items>
                    </SegmentedButton>
                </FlexBox>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <Table
                id="apiTable"
                growing="true"
                growingThreshold="20"
                growingScrollToLoad="true"
                sticky="HeaderToolbar,ColumnHeaders"
                noDataText="{view>/noDataText}"
                class="sapUiResponsiveMargin"
                width="auto">
                <headerToolbar>
                    <OverflowToolbar>
                        <Title text="{view>/tableTitle}" level="H3"/>
                    </OverflowToolbar>
                </headerToolbar>
                <columns>
                    <Column width="40%">
                        <Text text="{= ${view>/isInternal} ? ${i18n>colDocument} : ${i18n>colApi} }"/>
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true" visible="{= !${view>/isInternal} }">
                        <Text text="{i18n>fieldType}"/>
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true" visible="{= !${view>/isInternal} }">
                        <Text text="{i18n>fieldVersion}"/>
                    </Column>
                    <Column visible="{= !${view>/isInternal} }">
                        <Text text="{i18n>fieldStatus}"/>
                    </Column>
                    <Column minScreenWidth="Tablet" demandPopin="true" visible="{view>/isInternal}">
                        <Text text="{i18n>fieldAuthor}"/>
                    </Column>
                    <Column minScreenWidth="Desktop" demandPopin="true">
                        <Text text="{i18n>fieldLastModified}"/>
                    </Column>
                </columns>
            </Table>
        </f:content>

        <f:dependents>
            <!-- Row templates; the table is bound in the controller depending on the page.
                 Both have one cell per column (hidden columns hide their cells). -->
            <ColumnListItem id="standardItemTemplate" type="Navigation" press=".onItemPress">
                <cells>
                    <ObjectIdentifier title="{title}" text="{description}" class="apiDescription"/>
                    <ObjectStatus text="{path: 'type', formatter: '.formatter.typeText'}" state="Information" inverted="true"/>
                    <Text text="{version}"/>
                    <ObjectStatus text="{status}" state="{path: 'status', formatter: '.formatter.statusState'}"/>
                    <Text text=""/>
                    <Text text="{lastModified}"/>
                </cells>
            </ColumnListItem>
            <ColumnListItem id="internalItemTemplate" type="Navigation" press=".onItemPress">
                <cells>
                    <ObjectIdentifier title="{title}" text="{description}" class="apiDescription"/>
                    <Text text=""/>
                    <Text text=""/>
                    <Text text=""/>
                    <Text text="{= ${author} || '-' }"/>
                    <Text text="{lastModified}"/>
                </cells>
            </ColumnListItem>
        </f:dependents>
    </f:DynamicPage>
</mvc:View>

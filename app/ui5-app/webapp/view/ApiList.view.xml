<mvc:View
    controllerName="com.app.controller.ApiList"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns:grid="sap.ui.layout.cssgrid"
    xmlns="sap.m"
    xmlns:f="sap.f"
    height="100%">
    <f:DynamicPage id="apiListPage" toggleHeaderOnTitleClick="false" class="apiHubPage">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{view>/title}" level="H2"/>
                </f:heading>
                <f:expandedContent>
                    <Text text="{view>/subtitle}"/>
                </f:expandedContent>
            </f:DynamicPageTitle>
        </f:title>

        <f:header>
            <f:DynamicPageHeader pinnable="false">
                <FlexBox wrap="Wrap" alignItems="Center" class="apiListFilters">
                    <SearchField
                        id="searchField"
                        width="24rem"
                        placeholder="{i18n>searchPlaceholder}"
                        search=".onSearch"
                        liveChange=".onSearchLiveChange"
                        class="sapUiMediumMarginEnd sapUiTinyMarginBottom"/>
                    <SegmentedButton id="typeFilter" width="15rem" selectedKey="all" selectionChange=".onTypeChange" visible="{= !${view>/isInternal} }" class="sapUiTinyMarginBottom">
                        <items>
                            <SegmentedButtonItem key="all" text="{i18n>typeAll}"/>
                            <SegmentedButtonItem key="rest" text="REST"/>
                            <SegmentedButtonItem key="soap" text="SOAP"/>
                        </items>
                    </SegmentedButton>
                </FlexBox>
            </f:DynamicPageHeader>
        </f:header>

        <f:content>
            <!-- Cards grid; bound in the controller depending on the page -->
            <f:GridList
                id="apiGrid"
                growing="true"
                growingThreshold="24"
                growingScrollToLoad="true"
                noDataText="{view>/noDataText}"
                class="apiGrid">
                <f:headerToolbar>
                    <Toolbar style="Clear" class="apiGridToolbar">
                        <Title text="{view>/tableTitle}" level="H3"/>
                    </Toolbar>
                </f:headerToolbar>
                <f:customLayout>
                    <grid:GridBoxLayout boxMinWidth="19rem"/>
                </f:customLayout>
            </f:GridList>
        </f:content>

        <f:dependents>
            <!-- SAP standard API card -->
            <f:GridListItem id="standardItemTemplate" type="Active" press=".onItemPress" class="apiCardItem">
                <VBox class="apiCard" justifyContent="SpaceBetween" height="100%">
                    <VBox>
                        <HBox alignItems="Start" class="apiCardHeader">
                            <core:Icon src="{path: 'type', formatter: '.formatter.typeIcon'}" size="1.5rem" class="apiCardIcon"/>
                            <VBox class="apiCardHeading">
                                <Text text="{title}" maxLines="2" class="apiName"/>
                                <Text text="{path: 'type', formatter: '.formatter.typeText'}" class="apiCardSubtitle"/>
                            </VBox>
                        </HBox>
                        <Text text="{description}" maxLines="3" class="apiDescription"/>
                    </VBox>
                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="apiCardFooter">
                        <HBox alignItems="Center">
                            <Text text="{= ${version} ? 'Version ' + ${version} : '' }" class="apiCardMeta sapUiSmallMarginEnd"/>
                            <ObjectStatus text="{status}" state="{path: 'status', formatter: '.formatter.statusState'}"/>
                        </HBox>
                        <Text text="{path: 'lastModified', formatter: '.formatter.date'}" wrapping="false" class="apiCardMeta"/>
                    </HBox>
                </VBox>
            </f:GridListItem>

            <!-- Internal API (SharePoint document) card -->
            <f:GridListItem id="internalItemTemplate" type="Active" press=".onItemPress" class="apiCardItem">
                <VBox class="apiCard" justifyContent="SpaceBetween" height="100%">
                    <VBox>
                        <HBox alignItems="Start" class="apiCardHeader">
                            <core:Icon src="{path: 'fileName', formatter: '.formatter.fileIcon'}" size="1.5rem" class="apiCardIcon"/>
                            <VBox class="apiCardHeading">
                                <Text text="{title}" maxLines="2" class="apiName"/>
                                <Text text="{path: 'fileName', formatter: '.formatter.fileType'}" class="apiCardSubtitle"/>
                            </VBox>
                        </HBox>
                        <Text text="{description}" maxLines="3" class="apiDescription"/>
                    </VBox>
                    <HBox justifyContent="SpaceBetween" alignItems="Center" class="apiCardFooter">
                        <Text text="{= ${author} || '' }" maxLines="1" class="apiCardMeta sapUiSmallMarginEnd"/>
                        <Text text="{path: 'lastModified', formatter: '.formatter.date'}" wrapping="false" class="apiCardMeta"/>
                    </HBox>
                </VBox>
            </f:GridListItem>
        </f:dependents>
    </f:DynamicPage>
</mvc:View>

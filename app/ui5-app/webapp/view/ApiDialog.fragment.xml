<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:form="sap.ui.layout.form">
    <Dialog
        id="apiDialog"
        title="{= ${form>/isEdit} ? ${i18n>apiDialogEditTitle} : ${i18n>apiDialogCreateTitle} }"
        contentWidth="34rem">
        <form:SimpleForm
            editable="true"
            layout="ResponsiveGridLayout"
            labelSpanL="4"
            labelSpanM="4"
            emptySpanL="0"
            emptySpanM="0"
            columnsL="1"
            columnsM="1">
            <Label text="{i18n>fieldTitle}" required="true"/>
            <Input
                value="{form>/title}"
                maxLength="100"
                valueState="{form>/titleState}"
                valueStateText="{i18n>fieldTitleRequired}"
                liveChange=".onApiTitleChange"/>

            <Label text="{i18n>fieldType}"/>
            <SegmentedButton selectedKey="{form>/type}">
                <items>
                    <SegmentedButtonItem key="rest" text="REST"/>
                    <SegmentedButtonItem key="soap" text="SOAP"/>
                </items>
            </SegmentedButton>

            <Label text="{i18n>fieldVersion}"/>
            <Input value="{form>/version}" maxLength="20"/>

            <Label text="{i18n>fieldStatus}"/>
            <ComboBox value="{form>/status}">
                <core:Item key="Active" text="Active"/>
                <core:Item key="Beta" text="Beta"/>
                <core:Item key="Draft" text="Draft"/>
                <core:Item key="Deprecated" text="Deprecated"/>
            </ComboBox>

            <Label text="{i18n>fieldDescription}"/>
            <TextArea value="{form>/description}" rows="4" maxLength="500" growing="true"/>
        </form:SimpleForm>
        <beginButton>
            <Button text="{i18n>save}" type="Emphasized" press=".onApiDialogSave"/>
        </beginButton>
        <endButton>
            <Button text="{i18n>cancel}" press=".onApiDialogCancel"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>

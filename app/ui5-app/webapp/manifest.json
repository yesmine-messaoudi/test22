{
  "_version": "1.12.0",
  "sap.app": {
    "id": "com.app",
    "type": "application",
    "title": "API Management App",
    "description": "A Fiori Elements application for API Management",
    "applicationVersion": {
      "version": "1.0.0"
    },
    "dataSources": {
      "mainService": {
        "uri": "/service/api_management_app/",
        "type": "OData",
        "settings": {
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "rootView": {
      "viewName": "com.app.view.App",
      "type": "XML",
      "async": true,
      "id": "app"
    },
    "dependencies": {
      "minUI5Version": "1.71",
      "libs": {
        "sap.ui.core": {},
        "sap.m": {},
        "sap.tnt": {},
        "sap.f": {},
        "sap.ui.layout": {}
      }
    },
    "resources": {
      "css": [
        {
          "uri": "css/style.css"
        }
      ],
      "resourceRoots": {
        "com.app": "./"
      }
    },
    "models": {
      "": {
        "type": "sap.ui.model.json.JSONModel",
        "settings": {}
      },
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "com.app.i18n.i18n",
          "bundleLocale": "en"
        }
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "viewType": "XML",
        "viewPath": "com.app.view",
        "controlId": "navContainer",
        "controlAggregation": "pages",
        "async": true
      },
      "routes": [
        {
          "pattern": "",
          "name": "main",
          "target": "page1"
        },
        {
          "pattern": "internalapi",
          "name": "internalApi",
          "target": "page2"
        },
        {
          "pattern": "standardapi",
          "name": "standardApi",
          "target": "page3"
        },
        {
          "pattern": "manageyourapi",
          "name": "manageYourApi",
          "target": "page4"
        },
        {
          "pattern": "manageusers",
          "name": "manageUsers",
          "target": "page5"
        }
      ],
      "targets": {
        "page1": {
          "viewName": "Main",
          "viewId": "page1",
          "viewLevel": 1
        },
        "page2": {
          "viewName": "InternalApis",
          "viewId": "page2",
          "viewLevel": 2
        },
        "page3": {
          "viewName": "StandardApis",
          "viewId": "page3",
          "viewLevel": 2
        },
        "page4": {
          "viewName": "ManageYourApi",
          "viewId": "page4",
          "viewLevel": 2
        },
        "page5": {
          "viewName": "ManageUsers",
          "viewId": "page5",
          "viewLevel": 2
        }
      }
    }
  }
} 
{
  "name": "app",
  "version": "1.0.0",
  "description": "API Hub - discover and manage APIs",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^1",
    "@sap-cloud-sdk/http-client": "^4.0.2",
    "@sap-cloud-sdk/util": "^4.0.2",
    "@sap/cds": "^8",
    "@sap/hana-client": "^2.24.26",
    "@sap/low-code-event-handler": "^1.2.5",
    "@sap/xssec": "^4.8.0",
    "express": "^4",
    "hdb": "^0.19.12"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^1",
    "@sap/dev-cap-tools": "^1.31.0"
  },
  "scripts": {
    "start": "cds-serve",
    "start-local": "cds watch --open ui5-app/webapp/index.html",
    "generate-entry-point": "dev-cap-tools gen-entrypoint",
    "cds-watch": "cds watch --open",
    "reset-local-db": "cds deploy"
  },
  "cds": {
    "deploy": {
      "to": "hana",
      "force": true
    },
    "build": {
      "target": ".",
      "tasks": [
        {
          "src": "db",
          "for": "hana",
          "options": {
            "model": [
              "db",
              "srv",
              "app"
            ],
            "namespace": "apiapp"
          }
        },
        {
          "src": "srv",
          "for": "node-cf"
        }
      ]
    },
    "requires": {
      "[development]": {
        "db": {
          "kind": "sqlite",
          "credentials": {
            "database": "db/local.sqlite"
          }
        },
        "auth": {
          "kind": "mocked",
          "users": {
            "alice@aymax.fr": {
              "password": "alice",
              "roles": [
                "APIHubUser"
              ],
              "attr": {
                "givenName": "Alice",
                "familyName": "Martin",
                "email": "alice@aymax.fr"
              }
            },
            "bob@aymax.fr": {
              "password": "bob",
              "roles": [
                "APIHubUser"
              ],
              "attr": {
                "givenName": "Bob",
                "familyName": "Durand",
                "email": "bob@aymax.fr"
              }
            },
            "guest@aymax.fr": {
              "password": "guest",
              "roles": [],
              "attr": {
                "givenName": "Guest",
                "familyName": "User",
                "email": "guest@aymax.fr"
              }
            }
          }
        }
      },
      "[production]": {
        "db": {
          "kind": "hana"
        },
        "auth": {
          "kind": "xsuaa"
        }
      }
    }
  },
  "lcap": true,
  "overrides": {
    "better-sqlite3": "^12"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  },
  "engines": {
    "node": "^20 || ^22"
  }
}
